<?xml version='1.0' encoding='windows-1252'?>
<!--
  El instalador MSI de kuidy.

  Nace de `cargo wix init`, pero la plantilla que genera esa orden esta pensada
  para una herramienta de linea de ordenes: instala en `Archivos de programa`
  pidiendo administrador, mete el binario en un `bin/` y ofrece anadirlo al
  PATH. kuidy no es eso, asi que aqui se cambian tres cosas:

    1. Se instala **por usuario**, en `%LOCALAPPDATA%\Programs\kuidy`. Sin UAC,
       sin pedir contrasena de administrador. Es como se instalaba la version
       de Electron, y es lo que permite que alguien sin permisos en su equipo
       del trabajo pueda probarla.
    2. Se crea un **acceso en el menu Inicio**. Sin el, un programa sin ventana
       propia al arrancar es practicamente imposible de encontrar.
    3. **No se toca el PATH**: kuidy se abre con el raton, no se escribe en una
       terminal.

  Lo que NO hace, y conviene saberlo: el MSI no esta firmado, asi que Windows
  seguira avisando al ejecutarlo. Firmarlo cuesta un certificado de pago al
  ano, que para esto no se sostiene.
-->

<!--
  Estos bloques los usa `cargo wix` para saber si construye el instalador de
  32 o de 64 bits. No se quitan aunque aqui no se instale en Archivos de
  programa: su ausencia rompe la orden.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <!--
      `UpgradeCode` identifica al producto entre versiones y **no puede
      cambiar nunca**: es lo unico por lo que Windows sabe que la 0.5 que se
      esta instalando sustituye a la 0.4 que ya estaba, en vez de ponerse al
      lado. Si se cambia, todo el que actualice acaba con dos kuidy
      instalados.
    -->
    <Product
        Id='*'
        Name='kuidy'
        UpgradeCode='168F1020-A296-4093-8EF0-C61CC6019A3F'
        Manufacturer='yoiberdev'
        Language='3082'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='kuidy: la letra de lo que suena, encima de todo'
            Manufacturer='yoiberdev'
            InstallerVersion='450'
            Languages='3082'
            Compressed='yes'
            InstallScope='perUser'
            InstallPrivileges='limited'
            SummaryCodepage='1252'
            />

        <!--
          `afterInstallInitialize` desinstala la version vieja antes de copiar
          la nueva. Lo contrario deja el .exe anterior suelto cuando el nombre
          del archivo no cambia.
        -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='Ya hay una version mas nueva de [ProductName] instalada. La instalacion se detiene aqui.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Instalacion de kuidy'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!--
              En una instalacion por usuario no se puede escribir en Archivos
              de programa. `Programs` dentro de LocalAppData es donde Windows
              espera encontrar los programas de un solo usuario.
            -->
            <Directory Id='LocalAppDataFolder' Name='LocalAppData'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='kuidy'>

                        <!--
                          En una instalacion por usuario la clave de cada
                          componente tiene que estar en HKCU, no puede ser el
                          propio fichero: el instalador no puede preguntarle a
                          HKLM por algo que vive en el perfil de un usuario, y
                          Windows lo rechaza al validar (ICE38). Y las carpetas
                          del perfil hay que decir explicitamente que se
                          borran al desinstalar (ICE64).
                        -->
                        <!--
                          GUID fijo y no '*': un componente que mezcla clave de
                          registro y fichero no admite el automatico, y ademas
                          tiene que ser **el mismo entre versiones** o una
                          actualizacion no reconoceria lo que ya estaba puesto.
                          No los cambies.
                        -->
                        <Component Id='Binario' Guid='E6ADA59B-7392-47ED-8679-946C9A136011'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\yoiberdev\kuidy'
                                Name='instalado'
                                Type='integer'
                                Value='1'
                                KeyPath='yes'/>
                            <File
                                Id='kuidyEXE'
                                Name='kuidy.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\kuidy.exe'/>
                            <RemoveFolder Id='QuitarAppFolder' On='uninstall'/>
                            <RemoveFolder
                                Id='QuitarProgramsFolder'
                                Directory='ProgramsFolder'
                                On='uninstall'/>
                        </Component>

                        <Component Id='Licencia' Guid='CE9BCBF0-2D21-4C4B-888C-4FFEB129F47D'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\yoiberdev\kuidy'
                                Name='licencia'
                                Type='integer'
                                Value='1'
                                KeyPath='yes'/>
                            <File
                                Id='LicenseFile'
                                Name='License.rtf'
                                DiskId='1'
                                Source='wix\License.rtf'/>
                        </Component>

                    </Directory>
                </Directory>
            </Directory>

            <!--
              El acceso del menu Inicio.

              En una instalacion por usuario la clave del componente tiene que
              estar en HKCU: un acceso directo no sirve como `KeyPath`, y sin
              uno valido el instalador no sabe si el componente sigue puesto.
            -->
            <Directory Id='ProgramMenuFolder'>
                <Component Id='AccesoDirecto' Guid='*'>
                    <Shortcut
                        Id='AccesoInicio'
                        Name='kuidy'
                        Description='La letra de lo que suena, encima de todo'
                        Target='[APPLICATIONFOLDER]kuidy.exe'
                        WorkingDirectory='APPLICATIONFOLDER'/>
                    <RegistryValue
                        Root='HKCU'
                        Key='Software\yoiberdev\kuidy'
                        Name='instalado'
                        Type='integer'
                        Value='1'
                        KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id='Principal'
            Title='kuidy'
            Description='El programa y su acceso en el menu Inicio.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='Binario'/>
            <ComponentRef Id='Licencia'/>
            <ComponentRef Id='AccesoDirecto'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!--
          El icono de "Aplicaciones instaladas" se saca del propio ejecutable,
          que ya lo lleva dentro puesto por `build.rs`. Asi no hay un segundo
          .ico en el repositorio que pueda quedarse desfasado del dibujo.
        -->
        <Icon Id='kuidyICO' SourceFile='$(var.CargoTargetBinDir)\kuidy.exe'/>
        <Property Id='ARPPRODUCTICON' Value='kuidyICO'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/yoiberdev/kuidy-lyrics'/>

        <!--
          `WixUI_InstallDir` es el asistente con pantalla de carpeta: el
          usuario puede elegir donde se instala, como hacia el instalador de
          la version de Electron. `WixUI_FeatureTree`, que es lo que pone la
          plantilla por defecto, ensena un arbol de componentes que aqui no
          significa nada porque solo hay uno.
        -->
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        <UI>
            <UIRef Id='WixUI_InstallDir'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

    </Product>
</Wix>
